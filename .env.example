# ============================================================
# G-Hostel Points API — environment variables
# Copy this file to ".env" (same folder) and fill in the values.
# On Render: Dashboard -> your service -> Environment -> add each
# of these as a separate "Environment Variable". Do NOT commit
# the real .env file to git.
# ============================================================

# Supabase project URL (Settings -> API -> Project URL)
SUPABASE_URL=https://vczkojdfuvdeywnmnino.supabase.co

# Supabase SERVICE ROLE key (Settings -> API -> service_role secret).
# This key has full DB access and bypasses Row Level Security.
# It lives ONLY here, on the server. It must NEVER be put in Excel,
# VBA, the website's frontend JS, or anywhere a browser can see it.
SUPABASE_SERVICE_ROLE_KEY=paste-your-service-role-key-here

# A secret string YOU make up (e.g. a random 32-character password).
# This is the only credential that goes inside the Excel workbook.
# It authenticates the "SUBMIT POINTS" and "SYNC STUDENTS" macros
# to this API. Excel never talks to Supabase directly.
EXCEL_API_KEY=choose-a-long-random-secret-here

# Port the server listens on (Render sets this automatically; only
# needed for local testing)
PORT=3000

# Comma-separated list of origins allowed to call the public,
# read-only endpoints from a browser (your website's domain(s))
ALLOWED_ORIGINS=https://your-ghostel-website.onrender.com
